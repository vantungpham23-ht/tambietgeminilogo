# pnpm 配置
# 确保在 Cloudflare Pages 环境中正确安装依赖

# 使用 pnpm 的节点链接器
node-linker=hoisted

# 忽略已存在的 node_modules
# 这可以防止旧文件与新安装冲突
ignore-existing=true

# 自动安装 peer 依赖
auto-install-peers=true

# 跳过构建脚本（除非明确需要）
# ignore-scripts=false

# 当设置为 true 时，如果 node_modules 中存在不匹配的包，pnpm 会报错
# 设为 false 可以强制覆盖
force=true

# 公共 registry
registry=https://registry.npmjs.org/

# 生产依赖只安装生产依赖
# 生产环境安装时使用
# production=true

# 开发依赖
# development=true
